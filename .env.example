# Copy to .env and fill in. Never commit .env.

# --- Database (the bundled PostgreSQL container uses these) ---
DB_NAME=pos_db
DB_USER=pos
DB_PASSWORD=                 # REQUIRED: a strong, unique password

# --- First admin login (created once, only if the system has no admin yet) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=              # at least 8 characters. Leave empty to have a random one printed in `docker compose logs app`

# --- App behaviour ---
APP_TIMEZONE=Africa/Nairobi
SEED_SHOP=0                  # 1 = load the starter milk/eggs/chicken/flour/oil products on first start
SESSION_HOURS=12             # idle time before a till is signed out

# --- Network ---
BIND_ADDR=127.0.0.1          # 127.0.0.1 = only this machine / your reverse proxy. Use 0.0.0.0 to reach it from other computers on a LAN.
APP_PORT=8080
TRUST_PROXY=0                # set to 1 ONLY when HTTPS is handled by a proxy in front (e.g. the bundled Caddy)
DOMAIN=                      # for automatic HTTPS: docker compose --profile https up -d   (also set TRUST_PROXY=1)
